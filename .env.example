# =============================================================================
# Emergency Command Center — environment template
# =============================================================================
# Copy to `.env.local` for local development. Do NOT commit `.env.local` or real secrets.
#
# Reference: docs/polish/env_setup_required.md (full matrix of vars + defaults).
# =============================================================================

# -----------------------------------------------------------------------------
# Minimum dashboard demo (map only — persistence falls back to in-memory demo-store)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# Supabase — browser + middleware (`NEXT_PUBLIC_*`) vs server writes (`SERVICE_ROLE`)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use EITHER publishable (recommended) OR legacy anon key name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Triage LLM — `AI_PROVIDER`: mock | featherless | gemma
# -----------------------------------------------------------------------------
# AI_PROVIDER=mock

# Featherless (OpenAI-compatible JSON triage + optional EL voice paths read same vars)
# FEATHERLESS_API_KEY=
# FEATHERLESS_MODEL=
# FEATHERLESS_BASE_URL=
# FEATHERLESS_JSON_RESPONSE=0
# FEATHERLESS_HTTP_REFERER=
# FEATHERLESS_X_TITLE=

# Google Gemma / Gemini API (Generative Language API — uses GEMMA_* env names in code)
# GEMMA_API_KEY=
# GEMMA_MODEL=

# -----------------------------------------------------------------------------
# GeoOps surge analyze — optional provider override (else inherits AI_PROVIDER)
# -----------------------------------------------------------------------------
# GEOOPS_PROVIDER=

# -----------------------------------------------------------------------------
# Mapbox — dashboard map (browser bundle; restrict token URLs in Mapbox dashboard)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Mapbox MCP — server-side geocode tool (`lib/tools/mapbox/mapboxToolConfig.ts`)
# MAPBOX_MCP_ENABLED must be exactly "true" to enable. Requires MAPBOX_ACCESS_TOKEN.
# -----------------------------------------------------------------------------
# MAPBOX_MCP_ENABLED=false
# MAPBOX_ACCESS_TOKEN=
# MAPBOX_MCP_URL=https://mcp.mapbox.com/mcp
# MAPBOX_MCP_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Twilio — PSTN, SMS, transfer REST (`lib/voice/voiceConfig.ts`)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_OPERATOR_FORWARD_NUMBER=
# TWILIO_OPERATOR_FORWARD_NUMBER_ALT=

# -----------------------------------------------------------------------------
# ElevenLabs — conversational agent + webhook HMAC (`lib/voice/voiceConfig.ts`)
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# IBM watsonx — optional transcript translation (`IBM_TRANSLATION_ENABLED=true`)
# -----------------------------------------------------------------------------
# IBM_TRANSLATION_ENABLED=false
# IBM_WATSONX_API_KEY=
# IBM_WATSONX_PROJECT_ID=
# IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# IBM_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# IBM_TRANSLATION_TARGET_LANGUAGE=en

# -----------------------------------------------------------------------------
# Advisory operator state — runtime wrapper (`lib/server/operatorAvailability.ts`)
# -----------------------------------------------------------------------------
# OPERATOR_AVAILABILITY=free
# OPERATOR_ASSIGNMENT_SOURCE=env

# -----------------------------------------------------------------------------
# Debug / infra (optional)
# -----------------------------------------------------------------------------
# ECC_VOICE_DEBUG=false
# PORT=3000
